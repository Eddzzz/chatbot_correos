# demo = fixtures ficticias explícitas; postgres = respaldo restaurado.
DATA_MODE=demo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Producción: definir clave propia. HTTPS es obligatorio por defecto.
# DJANGO_SECRET_KEY=
# Opcional al rotar la clave, para verificar las firmas anteriores del historial.
# DJANGO_SECRET_KEY_FALLBACK=
# BOLIPOST_HOST=bolipost.example.org
# DJANGO_ALLOWED_HOSTS=bolipost.example.org
GROQ_API_KEY=
# Segunda clave Groq con el mismo modelo al agotar cuota/saldo de la primera.
GROQ_BACKUP_API_KEY=
# Último respaldo al agotar ambas claves Groq; dejar vacío para deshabilitarlo.
OPENROUTER_API_KEY=
AI_PROVIDER=groq
NVIDIA_API_KEY=
NVIDIA_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Modelo fijo: openai/gpt-oss-120b. La clave permanece en el servidor.
BUSINESS_DATABASE_URL=
# Habilitar para bases preparadas con las vistas assistant.
BUSINESS_USE_ISOLATED_VIEWS=0
# URL administrativa solo para comandos locales de preparación.
BUSINESS_ADMIN_DATABASE_URL=
BUSINESS_READONLY_PASSWORD=
BACKUP_PATH=D:\edwin\Documents\correos\backapsiop\backapsiop.sql
PG_BIN=D:\Program Files\PostgreSQL\bin
